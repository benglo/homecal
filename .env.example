# Copy to .env (gitignored). docker compose reads it from the repo root.

# Host port the calendar is published on.
HOMECAL_PORT=8787

# Host directory bind-mounted to /data. Holds the SQLite .db/-wal/-shm and photos.
# Put it somewhere your server backs up.
HOMECAL_DATA_DIR=./data

# Shared secret between the server, the Pi voice service (/etc/homecal-voice.env)
# and the kokoro-tts sidecar. Leave empty to disable voice (voice routes return 503).
# Generate one with: openssl rand -hex 32
PI_API_TOKEN=
